# Nexus - AI-Powered Agricultural Market Intelligence Backend
# Open Government Data (data.gov.in) API key
# Sign up for a free key at https://data.gov.in (Sign Up -> My Account -> API Keys)
DATA_GOV_API_KEY=

# Optional: Google Maps Distance Matrix API Key (if empty, Haversine fallback is used automatically)
GOOGLE_MAPS_API_KEY=

# Cache expiry in seconds (default: 21600 seconds = 6 hours)
CACHE_EXPIRY_SECONDS=21600

# Server port
PORT=5000
